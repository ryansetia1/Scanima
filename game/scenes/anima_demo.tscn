[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/anima_demo.gd" id="1_demo"]
[ext_resource type="Script" path="res://scripts/anima_presenter.gd" id="2_presenter"]
[ext_resource type="Theme" path="res://themes/mobile_theme.tres" id="3_theme"]
[ext_resource type="Script" path="res://scripts/scanima_background.gd" id="4_background"]

[node name="AnimaDemo" type="Node2D"]
script = ExtResource("1_demo")

[node name="Background" type="Node2D" parent="."]
z_index = -10
script = ExtResource("4_background")

[node name="Stage" type="Node2D" parent="."]
position = Vector2(360, 700)

[node name="Anima" type="AnimatedSprite2D" parent="Stage"]
unique_name_in_owner = true
script = ExtResource("2_presenter")

[node name="UI" type="CanvasLayer" parent="."]

[node name="Margin" type="MarginContainer" parent="UI"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("3_theme")
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 32
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 32

[node name="Column" type="VBoxContainer" parent="UI/Margin"]
layout_mode = 2
alignment = 2
theme_override_constants/separation = 16

[node name="HeaderCard" type="PanelContainer" parent="UI/Margin/Column"]
layout_mode = 2

[node name="HeaderColumn" type="VBoxContainer" parent="UI/Margin/Column/HeaderCard"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Title" type="Label" parent="UI/Margin/Column/HeaderCard/HeaderColumn"]
layout_mode = 2
theme_override_colors/font_color = Color(0.278, 0.902, 1, 1)
theme_override_colors/font_outline_color = Color(0.2, 0.55, 1, 0.32)
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 46
text = "ANIMA LAB"

[node name="Subtitle" type="Label" parent="UI/Margin/Column/HeaderCard/HeaderColumn"]
layout_mode = 2
theme_type_variation = &"EyebrowLabel"
text = "SPRITE INSPECTOR  //  DEVELOPMENT UNIT"

[node name="Spacer" type="Control" parent="UI/Margin/Column"]
layout_mode = 2
size_flags_vertical = 3

[node name="InfoCard" type="PanelContainer" parent="UI/Margin/Column"]
layout_mode = 2

[node name="Info" type="Label" parent="UI/Margin/Column/InfoCard"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "INITIALIZING ART LINK…"
autowrap_mode = 2

[node name="PoseRow" type="HBoxContainer" parent="UI/Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="HopButton" type="Button" parent="UI/Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 104)
