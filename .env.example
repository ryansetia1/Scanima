# Salin ke .env atau .env.local lalu isi. Keduanya tidak pernah masuk git.
#
# Cuma satu kredensial, karena Vision dan image generation dua-duanya lewat
# Replicate. Kunci ini hanya untuk harness eval di laptop; di produksi ia hidup
# sebagai Supabase Edge Function secret dan tidak pernah masuk build Godot.

REPLICATE_API_TOKEN=

