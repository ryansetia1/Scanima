# Salin ke .env lalu isi. .env tidak pernah masuk git.
# Kunci ini hanya untuk harness eval di laptop. Di produksi keduanya hidup
# sebagai Supabase Edge Function secrets dan tidak pernah masuk build Godot.

GEMINI_API_KEY=
REPLICATE_API_TOKEN=

